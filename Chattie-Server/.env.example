# Daraja environment: sandbox for testing, production for live payments.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_URL=https://your-api-domain.example/api/subscriptions/mpesa/callback
MPESA_AFTERDARK_CALLBACK_URL=https://your-api-domain.example/api/afterdark/payments/mpesa/callback
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://your-api-domain.example/api/afterdark/payouts/mpesa/result
MPESA_B2C_TIMEOUT_URL=https://your-api-domain.example/api/afterdark/payouts/mpesa/timeout

# Approximate conversion for the USD-denominated premium plans.
MPESA_USD_TO_KES_RATE=130
# Apply all database migrations before deployment, including
# database/migrations/008_sessions_and_web_push.sql.
# M-Pesa B2C requires a production Daraja app with B2C access and publicly
# reachable HTTPS result/timeout URLs. Pending earnings require admin clearance.
# Payout destinations currently use the existing plaintext account_number column;
# add at-rest encryption before enabling production payouts.

# Optional. Leave unset to retain the Paystack account's default currency.
# PAYSTACK_CURRENCY=
# Set this to the Chattie frontend's HTTPS /upgrade URL so Paystack returns to
# the app after checkout, where the server verifies the transaction reference.
PAYSTACK_CALLBACK_URL=https://your-web-domain.example/upgrade
# Generate 32 random bytes and base64 encode them. Keep this stable and secret;
# it encrypts reusable Paystack authorizations saved by checkout.
PAYMENT_METHOD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Paystack creator payouts require a transfer-enabled account funded in KES.
# Protect PAYSTACK_SECRET_KEY and configure the Paystack webhook URL as
# https://your-api-domain.example/api/afterdark/payments/paystack/webhook.

# Generate a VAPID key pair for background browser push (for example with
# `npx web-push generate-vapid-keys`). Keep the private key server-side.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.example
